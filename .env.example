# Supabase - Proyecto Arbolia (ExpoCom Tucuman 2026)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL publica que se codifica en el QR de la pantalla principal.
# Debe apuntar a la ruta movil, ej: https://arbolia.vercel.app/idea
VITE_PUBLIC_URL=http://localhost:5173

# Meta de ideas para ExpoCom
VITE_GOAL=500

# ---------------------------------------------------------------------
# Claude (Anthropic) — revisión semántica de propuestas y asistente Migue
#
# SIN prefijo VITE_, y es a proposito. Todo lo que Vite empaqueta termina
# dentro del JavaScript que descarga cada visitante: una clave con VITE_
# delante es una clave publicada, la lee cualquiera abriendo las
# herramientas de desarrollo y el consumo lo paga el municipio.
#
# Esta variable solo existe en el servidor. En Vercel se carga en
# Settings > Environment Variables (Production y Preview).
#
# Si falta, la instalacion sigue funcionando: la revision semantica se
# saltea y decide el filtro de palabras de la base. Migue queda apagado.
ANTHROPIC_API_KEY=sk-ant-...

# Las funciones de /api validan la sesion del panel contra Supabase.
# Si no se definen, caen a las VITE_ de arriba (mismo proyecto).
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...
